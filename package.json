    "hono": "^4.10.6",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/pg": "^8.15.6",
    "bun-types": "^1.3.0",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
